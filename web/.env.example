# Copy to .env (never commit the real one). All panel credentials stay here,
# on the server — the browser never sees them.
WEB_PORT=3100
WEB_ADMIN_USER=admin
# Generate with: bun server/hash-password.ts <password>
WEB_ADMIN_PASSWORD_HASH=

# Unix socket of the privileged vpnsetup agent (vpnsetup agent install).
VPN_SETUP_AGENT_SOCKET=/run/vpnsetup/agent.sock

# Marzban (sudo admin login for nodes; plain admin is enough for users)
MARZBAN_URL=http://127.0.0.1:8000
MARZBAN_USERNAME=
MARZBAN_PASSWORD=

# Remnawave (static API token)
REMNAWAVE_URL=http://127.0.0.1:3000
REMNAWAVE_TOKEN=

# 3x-ui (base URL including webBasePath + admin-scoped API token)
XUI_URL=http://127.0.0.1:2053
XUI_TOKEN=
